<?xml version="1.0" encoding="utf-8"?>
<!-- M-APP14 主布局：结构与 App.tsx 渲染树一一对应。
     root（insets padding 承接者，edge-to-edge）→ SwipeRefreshLayout{WebView 直接子 View}（集成硬约束）
     + 进度条（顶层覆盖式不占布局位，显隐零 2.5dp 跳动）
     + 首载遮罩 + 错误页（clickable 吞触摸——原生 View 不设会漏点击到 WebView）
     + 底部外跳横幅 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- SwipeRefreshLayout extends ViewGroup（非 FrameLayout）：child 的尺寸唯一来源是
         其 onMeasure 里的 mTarget.measure(EXACTLY)。XML 预置 WebView + 代码 removeAllViews
         换实例会删掉库自管理的 circleView 并使 mTarget 指向死实例 → 新 WebView 0×0 白屏
         （M-APP14 真机白屏事故根因）。故此处必须为空容器，WebView 一律由 attachWebView()
         代码创建加入；移除旧实例也只许 removeView(旧实例)，绝不用 removeAllViews。 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:max="100"
        android:progressDrawable="@drawable/progress_web"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone">

        <!-- 品牌开屏图（M-APP14c）：纯 Kotlin 壳冷启动飞快，windowBackground 的帆船组合
             首帧即被本遮罩盖掉；并入后系统开屏→windowBackground→本遮罩三层品牌视觉连续，
             驻留不再依赖启动速度。 -->
        <ImageView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/splashscreen_logo" />

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/loading_text"
            android:textColor="@color/inkSoft"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_icon"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/error_title"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_hint"
            android:textColor="@color/inkSoft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:paddingLeft="40dp"
            android:paddingTop="12dp"
            android:paddingRight="40dp"
            android:paddingBottom="12dp"
            android:text="@string/error_retry"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_outline"
                android:gravity="center"
                android:paddingLeft="22dp"
                android:paddingTop="9dp"
                android:paddingRight="22dp"
                android:paddingBottom="9dp"
                android:text="@string/error_back"
                android:textColor="@color/brand"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/btn_outline"
                android:gravity="center"
                android:paddingLeft="22dp"
                android:paddingTop="9dp"
                android:paddingRight="22dp"
                android:paddingBottom="9dp"
                android:text="@string/error_home"
                android:textColor="@color/brand"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_banner"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bannerClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/banner_close"
            android:textColor="@color/inkSoft"
            android:textSize="20sp" />
    </LinearLayout>

</FrameLayout>
