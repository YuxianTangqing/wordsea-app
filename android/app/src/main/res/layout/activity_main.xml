<?xml version="1.0" encoding="utf-8"?>
<!-- 批④ 重排：root 垂直 LinearLayout〔contentContainer(weight=1) ｜ tabBarHost〕——
     tab 栏是 WebView 的兄弟节点（布局分割式避让，非覆盖层=WebView 测量天然止于栏顶，
     零注入 CSS、零与 SPA 软导航竞态）。内容区含：swipe{WebView 代码创建}（mTarget
     铁律：必须空容器）+ nativeHost（批④ 原生 tab 屏挂载位）+ 进度条/首载遮罩/错误页/
     外跳横幅（盖内容区，不盖 tab 栏）。edge-to-edge insets 由 root padding 承接
     （KeyboardInsetController.install）——tab 栏自动落在系统导航区之上。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SwipeRefreshLayout extends ViewGroup（非 FrameLayout）：child 的尺寸唯一来源是
             其 onMeasure 里的 mTarget.measure(EXACTLY)。XML 预置 WebView + 代码 removeAllViews
             换实例会删掉库自管理的 circleView 并使 mTarget 指向死实例 → 新 WebView 0×0 白屏
             （M-APP14 真机白屏事故根因）。故此处必须为空容器，WebView 一律由 attachWebView()
             代码创建加入；移除旧实例也只许 removeView(旧实例)，绝不用 removeAllViews。 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 批④ 原生 tab 屏挂载位（懒建，GONE/VISIBLE 由 MainActivity 状态机管） -->
        <FrameLayout
            android:id="@+id/nativeHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_web"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:visibility="gone">

            <!-- 品牌开屏图（M-APP14c）：系统开屏→windowBackground→本遮罩三层品牌视觉连续。 -->
            <ImageView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/splashscreen_logo" />

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:indeterminateTint="@color/brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/loading_text"
                android:textColor="@color/inkSoft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_icon"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_title"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/error_hint"
                android:textColor="@color/inkSoft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:paddingLeft="40dp"
                android:paddingTop="12dp"
                android:paddingRight="40dp"
                android:paddingBottom="12dp"
                android:text="@string/error_retry"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_outline"
                    android:gravity="center"
                    android:paddingLeft="22dp"
                    android:paddingTop="9dp"
                    android:paddingRight="22dp"
                    android:paddingBottom="9dp"
                    android:text="@string/error_back"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:background="@drawable/btn_outline"
                    android:gravity="center"
                    android:paddingLeft="22dp"
                    android:paddingTop="9dp"
                    android:paddingRight="22dp"
                    android:paddingBottom="9dp"
                    android:text="@string/error_home"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_banner"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bannerClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/banner_close"
                android:textColor="@color/inkSoft"
                android:textSize="20sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 批④ 原生五 tab 栏（代码构建填入；高度 wrap） -->
    <FrameLayout
        android:id="@+id/tabBarHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
