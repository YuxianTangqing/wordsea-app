<?xml version="1.0" encoding="utf-8"?>
<!-- wordsea-app：无 Application 子类（宿主零逻辑）；与轻壳清单同构（批②） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 壳内自更新：下载 APK 后直接弹系统安装器（8.0+ 的「安装未知应用」
         按来源授权，系统安装流会自动引导到设置，无需代码侧运行时申请） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 批⑨ 听书前台服务（锁屏/后台连读）：FGS 基础权限（28+）+mediaPlayback 类型
         （34+ 缺它 startForeground 直接 SecurityException）+WakeLock（块间合成间隙
         保 CPU）+通知（33+ 运行时；未授权 FGS 照跑、锁屏媒体卡读 MediaSession 不依赖） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M362 语音评论麦克风（网页 getUserMedia）：WebView 的 onPermissionRequest
         叠加本地授权层，运行时申请在 MainActivity（micPermissionLauncher）。
         uses-feature 非必需——无麦设备照装，录音功能照实报不支持 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- 包可见性：外跳送系统浏览器（ACTION_VIEW https）需要；批③ 三家登录宿主 App
         可见性（微信 isWXAppInstalled 探测 / QQ 拉起与 WAP 兜底 / 支付宝预留）；
         批⑨R TTS_SERVICE——targetSdk 30+ 枚举设备语音引擎（TtsEngineHolder 多引擎
         兜底 queryIntentServices）需要，缺声明=兜底链空转只剩默认引擎一发（站主真机
         「语音引擎初始化失败」实录：系统试听可用但 APP 绑定默认引擎失败）；
         批⑧ B站 SDK——拉起走隐式 VIEW intent bilibili.oauth://main（非包名直跳），
         可见性须 scheme 形态（反汇编实锤，B站客户端与 SDK 内置 H5 兜底共用） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bilibili.oauth" />
        </intent>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.SplashScreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sihaishumeng" />
            </intent-filter>
        </activity>

        <!-- 批③ B站 WebView 授权屏（透明承载，站内回调完成即收）。批③R：主题换
             AppCompat 族透明款——框架 Translucent 主题+AppCompatActivity=点开必崩 -->
        <activity
            android:name=".social.BiliAuthActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.App.Translucent" />

        <!-- 微信回跳硬契约：包名必须是 {applicationId}.wxapi、类名 WXEntryActivity、
             exported、无 intent-filter（开放平台文档）——命名错一字回调静默不达 -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.sihaishumeng.app"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- QQ open-sdk 清单（jar 无 manifest 须手声）：scheme=tencent+AppID 字面拼接 -->
        <activity
            android:name="com.tencent.tauth.AuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tencent1905824730" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tencent.connect.common.AssistActivity"
            android:configChanges="orientation|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 批⑤R 支付宝授权回跳接收（首发「支付宝跳转不回来」根治）：AAR 内 AlipayResultActivity
             是 exported 空壳（零 intent-filter），支付宝 App 授权完按 OpenAuthTask.execute 首参
             scheme 隐式 intent 回跳——接收 filter 必须商户自声明（官方极简版 SDK 口径）。属性与
             AAR 逐字一致（免 merge 冲突），只补 scheme filter；scheme 用独立值 sihaishumengalipay
             ——严禁与 MainActivity 的 sihaishumeng 共用（两 activity 同 scheme=隐式 intent 二义，
             原注释「回跳走显式组件不经 scheme 解析」为错误断言，本批作废）。原生钱包与 H5 中转
             （未装支付宝设备）两链共用此入口。 -->
        <activity
            android:name="com.alipay.sdk.app.AlipayResultActivity"
            android:configChanges="orientation|keyboardHidden|navigation|screenSize|locale|keyboard|screenLayout|density|fontScale|layoutDirection|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sihaishumengalipay" />
            </intent-filter>
        </activity>

        <!-- 批⑨ 听书前台服务：纯宿主（通知栏+MediaSession+音频焦点；状态机在
             TtsSessionManager 进程单例）。⚠️ 不得加 android:process——跨进程会打断
             cookie 桥、WebView 弱引用与进程单例（对抗审查 A6）。exported=false：通知
             按钮走 PendingIntent.getForegroundService 不需要导出。 -->
        <service
            android:name=".core.tts.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- DownloadManager 落 app 私有外部目录的更新包，经 FileProvider
             授权给系统安装器读（external-files-path 只圈 Download/ 一处） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
